<launch>
  <!-- 多机仿真/实机通用启动文件 -->
  <!-- 仿真启动示例：roslaunch safe_valley_exp safe_flock_sim.launch uav_name:=UAV6 -->
  
  <arg name="uav_name" default="" />
  <arg name="enable_submode_publisher" default="true" />
  <arg name="safe_flock_exec" default="safe_flock_main.py" />
  <arg name="enable_rosbag" default="false" />
  <arg name="rosbag_dir" default="$(env HOME)/rosbagrec" />

  <!-- 1. 算法核心节点 -->
  <node pkg="safe_valley_exp" type="$(arg safe_flock_exec)" name="safe_flock" output="screen">
    <!-- 加载算法配置 -->
    <rosparam file="$(find safe_valley_exp)/config/flock.yaml" command="load" />
    <rosparam file="$(find safe_valley_exp)/config/obstacles.yaml" command="load" />
    <!-- 显式指定本机名称 -->
    <param name="own_name" value="$(arg uav_name)" />
  </node>

  <!-- 1.1 子模式输入（用于仿真/调试，向 /offb_submode 发布 hover/form/navi） -->
  <node if="$(arg enable_submode_publisher)" pkg="safe_valley_exp" type="submode_publisher.py" name="submode_publisher" output="screen" />

  <!-- 2. 集群通信桥接节点 (ZeroMQ) -->
  <node pkg="swarm_topology_bridge" type="bridge_node.py" name="swarm_bridge" output="screen">
    <!-- 加载仿真拓扑配置（包含 localhost IP 和端口偏移） -->
    <!-- <rosparam file="$(find swarm_topology_bridge)/config/topology.yaml" command="load" /> -->
    <rosparam file="$(find swarm_topology_bridge)/config/topology_sim_swarm.yaml" command="load" />
    <param name="uav_name" value="$(arg uav_name)" />
  </node>

  <node if="$(arg enable_rosbag)" pkg="safe_valley_exp" type="rosbag_record.py" name="rosbag_record" output="screen"
        args="--dir $(arg rosbag_dir) --prefix $(arg uav_name)_safe_valley /mavros/setpoint_velocity/cmd_vel /mavros/setpoint_position/local /mavros/global_position/set_gp_origin /mavros/state /mavros/local_position/odom /offb_submode" />
</launch>
